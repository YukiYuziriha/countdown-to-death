<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/reminder_notification_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/reminder_notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/reminder_panel_title"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/reminder_notification_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:breakStrategy="high_quality"
        android:ellipsize="end"
        android:maxLines="5"
        android:textColor="@color/reminder_panel_message"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
