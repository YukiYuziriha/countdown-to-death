{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Countdown to Death",
  "version": "1.0.2",
  "identifier": "com.countdowntodeath.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "countdown-main",
          "windows": ["main"],
          "permissions": ["allow-get-state", "allow-save-state", "allow-get-status", "allow-quit-app"]
        }
      ],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "category": "Utility",
    "icon": ["icons/app.png", "icons/app.ico"]
  }
}
